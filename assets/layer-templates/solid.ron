// Solid layer: a composition-sized rectangle rasterized with a color constant
// (REQ-LAYER-008: Rect → Rasterize(color ← RGB Color) → Out).
//
// The rectangle is the layer's own content, which is what gives a Solid a size
// it can be asked to change (`sizing: "fixed"` plus a width and height). It
// starts at `"auto"`, whose value is the composition frame — the same quad
// `net.in`'s `base_geometry` answered before, vertex for vertex, so an
// existing Solid and a new one look identical.
LayerTemplate(
    key: "solid",
    display_name: "Solid",
    nodes: [
        TemplateNode(
            key: "in",
            type_key: "net.in",
            label: Some("In"),
            position: (-360.0, 0.0),
            outputs: [
                OutputPort(name: "base_geometry", data_type: DataTypeId(50)),
                OutputPort(name: "t", data_type: DataTypeId(10)),
                OutputPort(name: "f", data_type: DataTypeId(10)),
            ],
        ),
        TemplateNode(
            key: "rect",
            type_key: "shape.rect",
            position: (-360.0, 180.0),
            params: [
                Parameter(key: "sizing", value: String("auto")),
            ],
        ),
        TemplateNode(
            key: "color",
            type_key: "constant.color",
            position: (-360.0, 360.0),
        ),
        TemplateNode(
            key: "rasterize",
            type_key: "rasterize",
            position: (-120.0, 0.0),
        ),
        TemplateNode(
            key: "out",
            type_key: "net.out",
            label: Some("Out"),
            position: (120.0, 0.0),
            inputs: [
                InputPort(name: "frame", accepted_types: [DataTypeId(1)]),
            ],
        ),
    ],
    edges: [
        TemplateEdge(from: ("rect", "output"), to: ("rasterize", "geometry")),
        TemplateEdge(from: ("color", "color"), to: ("rasterize", "color")),
        TemplateEdge(from: ("rasterize", "output"), to: ("out", "frame")),
    ],
)
