# Justified exceptions for scripts/lint-patterns.sh.
# Format: <rule> <file> <detail>
# Every entry needs a comment explaining why it is allowed.

# Durable shared state: Option<PanelKind> means "no panel focused", not a
# one-shot event. Kept in sync by GPUI focus events (Phase 3).
global-option-event crates/ravel-app/src/panels/mod.rs FocusedPanelGlobal

# Durable shared state: Option<FrameBuffer> is the current viewer display
# frame — None means "nothing to show". Updated on selection/eval change.
global-option-event crates/ravel-app/src/panels/mod.rs ViewerFrame

# Existing focus-repaint observers; removal is Phase 5 of the command/focus
# refactor plan (docs/implementation/gpui-command-focus-refactor-plan.md).
observe-global crates/ravel-app/src/panels/mod.rs FocusedPanelGlobal
observe-global crates/ravel-app/src/panels/node_editor.rs FocusedPanelGlobal
# Durable shared selection state: Viewer writes must repaint Node Editor node
# highlighting immediately (REQ-UI-011 unit 4).
observe-global crates/ravel-app/src/panels/node_editor.rs CanvasSelection
observe-global crates/ravel-app/src/panels/properties.rs FocusedPanelGlobal
observe-global crates/ravel-app/src/panels/timeline.rs FocusedPanelGlobal

# Durable shared UI state (REQ-UI-013): the Timeline mirrors the active
# composition and highlights the shared layer selection, both of which the
# Outliner and composition commands also write. Same lifecycle as
# CanvasSelection in the Node Editor.
observe-global crates/ravel-app/src/panels/timeline.rs ActiveComposition
observe-global crates/ravel-app/src/panels/timeline.rs LayerSelection
# The Node Editor opens the network of the shared layer selection (REQ-UI-013
# unit 3). Timeline and Outliner both write that selection, so observing the
# durable state replaces per-writer pushes into this panel.
observe-global crates/ravel-app/src/panels/node_editor.rs LayerSelection

# Outliner panel (REQ-UI-013 unit 3): the tree repaints on focus, mirrors the
# active composition and the shared layer selection it writes with the
# Timeline, and highlights the node selection it writes with the Node Editor.
# All durable shared state, same lifecycle as CanvasSelection.
observe-global crates/ravel-app/src/panels/outliner.rs FocusedPanelGlobal
observe-global crates/ravel-app/src/panels/outliner.rs ActiveComposition
observe-global crates/ravel-app/src/panels/outliner.rs LayerSelection
observe-global crates/ravel-app/src/panels/outliner.rs CanvasSelection

# Legacy cross-panel signals scheduled for Phase 5 (EventEmitter migration).
observe-global crates/ravel-app/src/panels/node_editor.rs PropertyChanged
observe-global crates/ravel-app/src/panels/properties.rs PropertyChanged
observe-global crates/ravel-app/src/panels/properties.rs SelectedPropertiesTarget

# Viewer panel: repaint on focus change (same as every other panel).
observe-global crates/ravel-app/src/panels/viewer.rs FocusedPanelGlobal
# Viewer panel: reads durable ViewerFrame to display the current evaluation
# result — not a one-shot event, same lifecycle as SelectedPropertiesTarget.
observe-global crates/ravel-app/src/panels/viewer.rs ViewerFrame

# Properties panel: PlaybackPosition is durable shared playhead state (same
# kind as ViewerFrame); node-target sections resample animated channels at
# the playhead's layer-local frame when it moves (REQ-LAYER-004).
observe-global crates/ravel-app/src/panels/properties.rs PlaybackPosition

# H-hold temporary hand tool (REQ-UI-011): raw key handling is the approved
# pattern for transient drag modes per .agents/rules/gpui.md.
panel-on-key-down crates/ravel-app/src/panels/viewer.rs on_key_down

# Viewer toolbar repaints when the active tool changes (durable shared state,
# same lifecycle as FocusedPanelGlobal / PlaybackPosition).
observe-global crates/ravel-app/src/panels/viewer.rs ToolState

# Viewer bbox overlay repaints when the canvas selection changes (durable
# shared selection state, REQ-UI-011 unit 3; same lifecycle as ToolState).
observe-global crates/ravel-app/src/panels/viewer.rs CanvasSelection
